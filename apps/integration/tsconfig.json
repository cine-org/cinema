{
  "extends": "@repo/typescript-config/nest.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "jest"],
    "paths": { "@/*": ["./src/*"] },
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}

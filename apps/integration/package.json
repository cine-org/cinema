{
  "name": "@repo/integration",
  "version": "0.0.0",
  "description": "External gateway — payment webhooks, storage, email providers",
  "license": "ISC",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "cross-env NODE_ENV=development dotenv -e .env -- nest start --watch",
    "start": "cross-env NODE_ENV=production dotenv -e .env -- nest start",
    "debug": "cross-env NODE_ENV=development dotenv -e .env -- nest start --debug --watch",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "cross-env NODE_ENV=test jest --config jest.config.mjs --passWithNoTests",
    "test:int": "cross-env NODE_ENV=test jest --config jest.config.mjs --testRegex '.int-spec.ts$' --passWithNoTests",
    "test:e2e": "cross-env NODE_ENV=test jest --config jest.config.mjs --testRegex '.e2e-spec.ts$' --passWithNoTests",
    "test:watch": "jest --config jest.config.mjs --watch",
    "test:cov": "cross-env NODE_ENV=test jest --config jest.config.mjs --coverage --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.3.0"
  }
}

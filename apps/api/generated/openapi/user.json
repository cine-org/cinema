  "info": {
    "title": "API Documentation",
    "description": "API docs for cinema-api",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "AccessTokenResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <accessToken>`."
          },
          "tokenType": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Refresh before this."
          }
        },
        "required": [
          "accessToken",
          "tokenType",
          "accessTokenExpiresAt"
        ]
      },
      "ChangePasswordRequestDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "example": "email"
          },
          "message": {
            "type": "string",
            "example": "Invalid email"
          },
          "code": {
            "type": "string",
            "example": "invalid_format"
          }
        },
        "required": [
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "message": {
            "type": "string",
            "example": "Request timed out"
          },
          "code": {
            "type": "string",
            "example": "NOT_FOUND"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "success",
          "message",
          "code",
          "timestamp"
        ]
      },
      "ForgotPasswordRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "IdResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LogoutAllResponseDto": {
        "type": "object",
        "properties": {
          "revokedSessions": {
            "type": "number",
            "description": "Sessions revoked, the current one included."
          }
        },
        "required": [
          "revokedSessions"
        ]
      },
      "LogoutResponseDto": {
        "type": "object",
        "properties": {
          "loggedOut": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "loggedOut"
        ]
      },
      "PaginatedResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          },
          "message": {
            "type": "string",
            "example": "OK"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "success",
          "meta",
          "message",
          "timestamp"
        ]
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "example": 42
          },
          "page": {
            "type": "number",
            "example": 1
          },
          "limit": {
            "type": "number",
            "example": 20
          },
          "totalPages": {
            "type": "number",
            "example": 3
          },
          "hasNextPage": {
            "type": "boolean",
            "example": true
          },
          "hasPreviousPage": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "total",
          "page",
          "limit",
          "totalPages",
          "hasNextPage",
          "hasPreviousPage"
        ]
      },
      "PasswordResetAcceptedResponseDto": {
        "type": "object",
        "properties": {
          "resetId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresInSeconds": {
            "type": "number",
            "example": 600,
            "description": "Lifetime of the emailed code."
          },
          "resendAfterSeconds": {
            "type": "number",
            "example": 60,
            "description": "Wait before requesting another code."
          }
        },
        "required": [
          "resetId",
          "expiresInSeconds",
          "resendAfterSeconds"
        ]
      },
      "PasswordUpdatedResponseDto": {
        "type": "object",
        "properties": {
          "passwordUpdated": {
            "type": "boolean",
            "enum": [
              true

# Local: 3000
# Staging: 3000
# Production: 3000
PORT=3000

# Local: http://localhost:3000
# Staging: https://api-staging.cine.io.vn
# Production: https://api.cine.io.vn
API_ORIGIN=

# Local: /api
# Staging: /api
# Production: /api
API_PREFIX=/api

# Local: http://localhost:4000,http://localhost:4001
# Staging: https://staging.cine.io.vn,https://admin-staging.cine.io.vn
# Production: https://cine.io.vn,https://admin.cine.io.vn
CORS_ORIGINS=

# Local: true
# Staging: true
# Production: false
ENABLE_SWAGGER=

# Local: log
# Staging: log
# Production: warn
LOG_LEVEL=

# PostgreSQL connection string.
DATABASE_URL=postgresql://cinema:cinema@localhost:5432/cinema

# Base64-encoded PKCS#8 private key and SPKI public key. Required in production.
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_PUBLIC_KEY_BASE64=
AUTH_JWT_ISSUER=cinema-api
AUTH_JWT_AUDIENCE=cinema-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_VERIFICATION_TTL_SECONDS=86400
AUTH_RESET_TTL_SECONDS=1800

# Base64-encoded 32-byte key used to encrypt email tokens in the outbox.
AUTH_OUTBOX_ENCRYPTION_KEY=
AUTH_REFRESH_COOKIE_NAME=cinema_refresh
WEB_ORIGIN=http://localhost:4000

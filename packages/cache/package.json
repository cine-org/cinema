  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "ioredis": "5.10.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4"
  }

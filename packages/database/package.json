{
  "name": "@repo/database",
  "version": "0.0.0",
  "description": "",
  "private": true,
  "license": "ISC",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:test:deploy": "dotenv -e ../../.env.test -- prisma migrate deploy",
    "db:test:reset": "dotenv -e ../../.env.test -- prisma migrate reset --force",
    "db:test:seed": "dotenv -e ../../.env.test -- prisma db seed",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --exclude '**/*.int-spec.ts' --exclude '**/*.e2e-spec.ts' --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "test:int": "dotenv -e ../../.env.test -- vitest run .int-spec.ts --passWithNoTests",
    "test:e2e": "dotenv -e ../../.env.test -- vitest run .e2e-spec.ts --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@repo/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/pg": "^8.15.5",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.21.0",
    "@repo/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4",
    "pg": "^8.16.3"
  }
}

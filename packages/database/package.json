{
  "name": "@repo/database",
  "version": "0.0.0",
  "description": "",
  "private": true,
  "license": "ISC",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "pnpm db:generate && tsc -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:test:deploy": "dotenv -e .env.test -- prisma migrate deploy",
    "db:test:check": "dotenv -e .env.test -- prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:test:reset": "dotenv -e .env.test -- prisma migrate reset --force",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "test:int": "dotenv -e .env.test -- vitest run .int-spec.ts --passWithNoTests",
    "test:e2e": "dotenv -e .env.test -- vitest run .e2e-spec.ts --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
    "vitest": "^3.2.4"
  }
}

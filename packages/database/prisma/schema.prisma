generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DEACTIVATED
  SUSPENDED

  @@map("user_status")
}

enum IdentityType {
  EMAIL
  PHONE

  @@map("identity_type")
}

enum AuthMethod {
  PASSWORD
  OAUTH

  @@map("auth_method")
}

enum AuthChallengeType {
  VERIFY_EMAIL
  RESET_PASSWORD

  @@map("auth_challenge_type")
}

enum RoleType {
  SYSTEM
  CUSTOM

  @@map("role_type")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED

  @@map("outbox_status")
}

model User {
  id                 String     @id @default(uuid())
  username           String     @unique
  normalizedUsername String     @unique @map("normalized_username")
  fullName           String?    @map("full_name")
  avatarUrl          String?    @map("avatar_url")
  status             UserStatus @default(PENDING_VERIFICATION)

  identities         UserIdentity[]
  oauthAccounts      OAuthAccount[]
  passwordCredential PasswordCredential?
  sessions           AuthSession[]
  challenges         AuthChallenge[]
  roles              UserRole[] @relation("UserRoleSubject")
  assignedRoles      UserRole[] @relation("UserRoleAssigner")

  dateOfBirth DateTime? @map("date_of_birth") @db.Date

  statusChangedAt DateTime @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([fullName])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model UserIdentity {
  id     String @id @default(uuid())
  userId String @map("user_id")

  type                 IdentityType
  identifier           String
  normalizedIdentifier String       @map("normalized_identifier")

  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdSessions AuthSession[]

  @@unique([type, normalizedIdentifier])
  @@unique([userId, type])
  @@index([lastUsedAt])
  @@map("user_identities")
}

model PasswordCredential {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  passwordHash      String   @map("password_hash")
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model OAuthAccount {
  id     String @id @default(uuid())
  userId String @map("user_id")

  provider        String
  providerSubject String @map("provider_subject")

  email       String?
  displayName String? @map("display_name")
  avatarUrl   String? @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("oauth_accounts")
}

model AuthSession {
  id                  String  @id @default(uuid())
  userId              String  @map("user_id")
  createdByIdentityId String? @map("created_by_identity_id")
  authMethod          AuthMethod @map("auth_method")

  deviceId   String? @map("device_id")
  deviceName String? @map("device_name")
  userAgent  String? @map("user_agent")
  ipAddress  String? @map("ip_address")

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByIdentity UserIdentity?  @relation(fields: [createdByIdentityId], references: [id], onDelete: SetNull)
  refreshTokens     RefreshToken[]

  @@index([userId])
  @@index([createdByIdentityId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([lastUsedAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        String @id @default(uuid())
  sessionId String @map("session_id")

  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)

  replacedByTokenId String? @unique @map("replaced_by_token_id")
  reuseDetectedAt   DateTime? @map("reuse_detected_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session         AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacedToken   RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([rotatedAt])
  @@index([reuseDetectedAt])
  @@map("refresh_tokens")
}

model AuthChallenge {
  id         String            @id @default(uuid())
  userId     String            @map("user_id")
  type       AuthChallengeType
  tokenHash  String            @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?         @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String?
  description String?
  type        RoleType @default(CUSTOM)

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([type])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("permissions")
}

model UserRole {
  id     String @id @default(uuid())
  userId String @map("user_id")
  roleId String @map("role_id")
  assignedBy String? @map("assigned_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user           User  @relation("UserRoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("UserRoleAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([assignedBy])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model SecurityAuditEvent {
  id           String   @id @default(uuid())
  actorUserId  String?  @map("actor_user_id")
  targetUserId String?  @map("target_user_id")
  sessionId    String?  @map("session_id")
  action       String
  outcome      String
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@map("security_audit_events")
}

model OutboxMessage {
  id               String       @id @default(uuid())
  topic            String
  encryptedPayload String       @map("encrypted_payload")
  status           OutboxStatus @default(PENDING)
  attempts         Int          @default(0)
  nextAttemptAt    DateTime     @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedAt         DateTime?    @map("locked_at") @db.Timestamptz(3)
  processedAt      DateTime?    @map("processed_at") @db.Timestamptz(3)
  lastError        String?      @map("last_error")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("outbox_messages")
}

model LegacyUser {
  id              String    @id
  email           String?   @unique
  isEmailVerified Boolean   @default(false)
  passwordHash    String
  username        String    @unique
  fullName        String?
  dateOfBirth     DateTime? @db.Date
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@map("User")
}

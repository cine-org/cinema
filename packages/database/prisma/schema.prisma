generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  passwordHash    String    @map("password_hash")
  fullName        String?   @map("full_name")
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  authChallenges AuthChallenge[]
  authSessions   AuthSession[]

  roleAssignments        RoleAssignment[] @relation("RoleAssignmentUser")
  grantedRoleAssignments RoleAssignment[] @relation("RoleAssignmentGrantedBy")
  revokedRoleAssignments RoleAssignment[] @relation("RoleAssignmentRevokedBy")

  @@map("users")
}

enum AuthChallengePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// One-time code sent to the account's email. The OTP itself is never stored: secretDigest is an
// HMAC over (id, accountId, purpose, users.email, otp). At most one active challenge per account
// and purpose (partial unique index in the migration).
model AuthChallenge {
  id             String               @id @default(uuid())
  accountId      String               @map("account_id")
  purpose        AuthChallengePurpose
  secretDigest   String               @map("secret_digest")
  failedAttempts Int                  @default(0) @map("failed_attempts")
  expiresAt      DateTime             @map("expires_at")
  consumedAt     DateTime?            @map("consumed_at")
  revokedAt      DateTime?            @map("revoked_at")
  createdAt      DateTime             @default(now()) @map("created_at")

  account User @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose, createdAt(sort: Desc), id(sort: Desc)])
  @@map("auth_challenges")
}

enum AuthSessionRevokedReason {
  LOGOUT
  LOGOUT_ALL
  SESSION_DELETED
  SESSION_LIMIT
  REPLAY
  PASSWORD_RESET
  PASSWORD_CHANGED
}

// One login. Valid while revokedAt is null and now < idleExpiresAt and now < absoluteExpiresAt.
// Each successful refresh sets lastRefreshedAt = now and
// idleExpiresAt = min(now + idle TTL, absoluteExpiresAt). absoluteExpiresAt never changes.
model AuthSession {
  id                String                    @id @default(uuid())
  accountId         String                    @map("account_id")
  createdAt         DateTime                  @default(now()) @map("created_at")
  lastRefreshedAt   DateTime                  @map("last_refreshed_at")
  idleExpiresAt     DateTime                  @map("idle_expires_at")
  absoluteExpiresAt DateTime                  @map("absolute_expires_at")
  revokedAt         DateTime?                 @map("revoked_at")
  revokedReason     AuthSessionRevokedReason? @map("revoked_reason")
  userAgent         String?                   @map("user_agent")
  ipAddress         String?                   @map("ip_address")

  account       User               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([accountId, revokedAt])
  @@index([idleExpiresAt])
  @@map("auth_sessions")
}

// Rotation chain of a session. Only the SHA-256 digest of the token is stored. Consumed tokens are
// kept to detect replay; their lifetime follows the session. At most one unconsumed token per
// session (partial unique index in the migration).
model AuthRefreshToken {
  id          String    @id @default(uuid())
  sessionId   String    @map("session_id")
  tokenDigest String    @unique @map("token_digest")
  createdAt   DateTime  @default(now()) @map("created_at")
  consumedAt  DateTime? @map("consumed_at")

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("auth_refresh_tokens")
}

// Where a role assignment applies. SELF is the customer's own data; the others are internal.
enum RoleScope {
  GLOBAL
  CLUSTER
  THEATER
  SELF
}

// Mirror of the permission catalog in code (modules/iam), synced on startup. A key no longer in
// code is marked deprecated, never deleted: role_permissions may still point at it.
model Permission {
  key          String    @id
  module       String
  description  String
  createdAt    DateTime  @default(now()) @map("created_at")
  deprecatedAt DateTime? @map("deprecated_at")

  roles RolePermission[]

  @@map("permissions")
}

// System roles are created by the migration and kept by the sync; custom roles by an admin.
// A locked role (SUPER_ADMIN) holds every permission and cannot be edited. `scopes` lists where
// the role may be granted; each assignment picks one of them.
model Role {
  id        String      @id @default(uuid())
  key       String      @unique
  name      String
  scopes    RoleScope[]
  isSystem  Boolean     @default(false) @map("is_system")
  isLocked  Boolean     @default(false) @map("is_locked")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  permissions RolePermission[]
  assignments RoleAssignment[]

  @@map("roles")
}

model RolePermission {
  roleId        String   @map("role_id")
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Restrict)

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

// Who holds which role, and where: clusterId for CLUSTER, theaterId for THEATER, neither
// otherwise (check constraint in the migration). Revoking sets revokedAt; rows are kept for
// history. At most one active role per account (partial unique index in the migration).
model RoleAssignment {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  roleId      String    @map("role_id")
  scope       RoleScope
  clusterId   String?   @map("cluster_id")
  theaterId   String?   @map("theater_id")
  grantedById String?   @map("granted_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by_id")

  user      User     @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  cluster   Cluster? @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  theater   Theater? @relation(fields: [theaterId], references: [id], onDelete: Restrict)
  grantedBy User?    @relation("RoleAssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy User?    @relation("RoleAssignmentRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([roleId])
  @@index([clusterId])
  @@index([theaterId])
  @@map("role_assignments")
}

// A group of theaters, usually a city; cluster roles work on every theater in theirs.
model Cluster {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  theaters        Theater[]
  roleAssignments RoleAssignment[]

  @@map("clusters")
}

enum TheaterStatus {
  DRAFT
  ACTIVE
  INACTIVE
  CLOSED
}

model Theater {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  streetAddress String        @map("street_address")
  ward          String
  province      String
  phoneNumber   String?       @map("phone_number")
  status        TheaterStatus @default(DRAFT)
  // Null until the theater is placed in a cluster.
  clusterId     String?       @map("cluster_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  cluster         Cluster?         @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  rooms           Room[]
  roleAssignments RoleAssignment[]

  @@index([clusterId])
  @@map("theaters")
}

enum RoomStatus {
  DRAFT
  ACTIVE
  INACTIVE
  CLOSED
}

model Room {
  id        String       @id @default(uuid())
  theaterId String       @map("theater_id")
  code      String
  name      String
  status    RoomStatus   @default(DRAFT)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  theater   Theater      @relation(fields: [theaterId], references: [id], onDelete: Restrict)
  layouts   RoomLayout[]

  // Code is unique per theater among non-closed rooms: partial index in the migration.
  @@index([theaterId])
  @@map("rooms")
}

enum RoomLayoutStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model RoomLayout {
  id          String           @id @default(uuid())
  roomId      String           @map("room_id")
  version     Int
  gridRows    Int              @map("grid_rows")
  gridCols    Int              @map("grid_cols")
  status      RoomLayoutStatus @default(DRAFT)
  publishedAt DateTime?        @map("published_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  room        Room             @relation(fields: [roomId], references: [id], onDelete: Restrict)
  seats       Seat[]

  @@unique([roomId, version])
  @@map("room_layouts")
}

model SeatType {
  code         String   @id
  name         String
  maxOccupancy Int      @map("max_occupancy")
  // Grid cells a seat of this type spans in a layout.
  width        Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  seats        Seat[]

  @@map("seat_types")
}

enum SeatStatus {
  ACTIVE
  INACTIVE
}

model Seat {
  id           String     @id @default(uuid())
  layoutId     String     @map("layout_id")
  seatTypeCode String     @map("seat_type_code")
  // seatCode = rowLabel + 2-digit columnNumber, e.g. "A01", "B12"
  rowLabel     String     @map("row_label")
  columnNumber Int        @map("column_number")
  x            Int
  y            Int
  status       SeatStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  layout       RoomLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  seatType     SeatType   @relation(fields: [seatTypeCode], references: [code], onDelete: Restrict)

  @@unique([layoutId, rowLabel, columnNumber])
  @@unique([layoutId, y, x])
  @@index([seatTypeCode])
  @@map("seats")
}

{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "dependsOn": ["^build"],
      "outputs": ["generated/**", "src/generated/**"]
    },
    "@repo/sdk-admin#generate": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/generated/openapi/admin.json"],
      "outputs": ["src/generated/**"]
    },
    "@repo/sdk-admin#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/generated/openapi/admin.json"],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "@repo/sdk-admin#typecheck": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/generated/openapi/admin.json"],
      "outputs": []
    },
    "@repo/sdk-user#generate": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/generated/openapi/user.json"],
      "outputs": ["src/generated/**"]
    },
    "@repo/sdk-user#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/generated/openapi/user.json"],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "@repo/sdk-user#typecheck": {
      "dependsOn": ["build", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/generated/openapi/user.json"],
      "outputs": []
    },
    "@repo/web-user#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@repo/web-admin#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "test:int": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "db:seed": {
      "dependsOn": ["^db:seed"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "clean": {
      "cache": false
    }
  }
}

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cinema
POSTGRES_PORT=5432

# Database roles
DB_MAX_CONNECTIONS=100
DB_APP_USER=cinema_app
DB_APP_PASSWORD=cinema_app
DB_MIGRATOR_USER=cinema_migrator
DB_MIGRATOR_PASSWORD=

# PgBouncer
PGBOUNCER_AUTH_FILE=./pgbouncer/.secrets/userlist.txt

# Redis standalone
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=redis

REDIS_QUEUE_PORT=6381
REDIS_QUEUE_PASSWORD=redis

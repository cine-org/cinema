# Local: postgres
# Staging: postgres
# Production: postgres
POSTGRES_USER=postgres

# Local: postgres
# Staging: <password>
# Production: <password>
POSTGRES_PASSWORD=

# Local: cinema
# Staging: cinema
# Production: cinema
POSTGRES_DB=cinema

# Local: 5432
# Staging: 5432
# Production: 5432
POSTGRES_PORT=5432

# Local: 100
# Staging: 100
# Production: 100
DB_MAX_CONNECTIONS=100

# Local: cinema_app
# Staging: cinema_app
# Production: cinema_app
DB_APP_USER=cinema_app

# Local: cinema_app
# Staging: <password>
# Production: <password>
DB_APP_PASSWORD=

# Local: cinema_migrator
# Staging: cinema_migrator
# Production: cinema_migrator
DB_MIGRATOR_USER=cinema_migrator

# Local: cinema_migrator
# Staging: <password>
# Production: <password>
DB_MIGRATOR_PASSWORD=

# Local: ./pgbouncer/.secrets/userlist.txt
# Staging: /etc/cinema/secrets/pgbouncer-userlist.txt
# Production: /etc/cinema/secrets/pgbouncer-userlist.txt
PGBOUNCER_AUTH_FILE=./pgbouncer/.secrets/userlist.txt

# Local: redis
# Staging: <password>
# Production: <password>
REDIS_PASSWORD=

# Local: 6379
# Staging: 6379
# Production: 6379
REDIS_PORT=6379

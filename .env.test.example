NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cinema_test
API_PREFIX=/api
PORT=3001
CORS_ORIGINS=http://localhost:4000
WEB_ORIGIN=http://localhost:4000
AUTH_JWT_ISSUER=cinema-api-test
AUTH_JWT_AUDIENCE=cinema-web-test

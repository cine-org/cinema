AUTH_RESET_TTL_SECONDS=1800
AUTH_OUTBOX_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AUTH_REFRESH_COOKIE_NAME=cinema_refresh
